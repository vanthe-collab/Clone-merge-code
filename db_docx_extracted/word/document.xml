/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh wp14"><w:body><w:p w14:paraId="15EC2E6F" w14:textId="77777777" w:rsidR="00AD1E07" w:rsidRDefault="00AD1E07" w:rsidP="00AD1E07"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:bookmarkStart w:id="0" w:name="_Toc241813416"/><w:r><w:t>3. CƠ SỞ DỮ LIỆU</w:t></w:r><w:bookmarkEnd w:id="0"/></w:p><w:p w14:paraId="20BE0F53" w14:textId="77777777" w:rsidR="00AD1E07" w:rsidRPr="0086622B" w:rsidRDefault="00AD1E07" w:rsidP="00AD1E07"><w:r w:rsidRPr="0086622B"><w:t xml:space="preserve">Toàn bộ mô hình dữ liệu của hệ thống </w:t></w:r><w:r><w:t xml:space="preserve">quản lý phòng trọ </w:t></w:r><w:r w:rsidRPr="0086622B"><w:t>được tổ chức thành các khối nghiệp vụ kết nối chặt chẽ qua các mối quan hệ thực thể.</w:t></w:r></w:p><w:p w14:paraId="365EA311" w14:textId="77777777" w:rsidR="00AD1E07" w:rsidRPr="0086622B" w:rsidRDefault="00AD1E07" w:rsidP="00AD1E07"><w:r w:rsidRPr="0086622B"><w:t>Ở khối quản lý người dùng và định danh, một vai trò hoặc trạng thái có thể áp dụng cho nhiều người dùng khác nhau. Mỗi người dùng có thể thực hiện nhiều lượt xác minh danh tính với nhiều loại giấy tờ, trạng thái và ảnh xác minh khác nhau, đồng thời sở hữu nhiều tài khoản ngân hàng. Giữa người dùng và sở thích cá nhân tồn tại mối quan hệ nhiều - nhiều, trong đó một người dùng có thể chọn nhiều sở thích và một sở thích cũng thuộc về nhiều người dùng thông qua bảng trung gian.</w:t></w:r></w:p><w:p w14:paraId="67A29AB1" w14:textId="77777777" w:rsidR="00AD1E07" w:rsidRPr="0086622B" w:rsidRDefault="00AD1E07" w:rsidP="00AD1E07"><w:r w:rsidRPr="0086622B"><w:t>Đối với quản lý nhà trọ và bài đăng, một địa điểm có thể chứa nhiều nhà trọ và một chủ nhà có thể sở hữu nhiều nhà trọ. Mỗi nhà trọ chia thành nhiều phòng, trong đó mỗi phòng gắn với một trạng thái, chứa nhiều ảnh mô tả và có thể xuất hiện trong nhiều bài đăng khác nhau qua các thời điểm. Mỗi bài đăng do một chủ nhà tạo ra, gắn với một địa điểm, thuộc một loại thuê và trạng thái cụ thể. Mối quan hệ giữa phòng và tiện ích là nhiều - nhiều thông qua bảng liên kết tiện ích phòng.</w:t></w:r></w:p><w:p w14:paraId="64155822" w14:textId="77777777" w:rsidR="00AD1E07" w:rsidRPr="0086622B" w:rsidRDefault="00AD1E07" w:rsidP="00AD1E07"><w:r w:rsidRPr="0086622B"><w:t>Ở mảng tin ở ghép và giao tiếp, một người dùng có thể đăng nhiều tin ở ghép liên kết với địa điểm và đơn đặt phòng. Mỗi tin ở ghép chứa nhiều ảnh, mở ra nhiều cuộc trò chuyện và phát sinh nhiều thỏa thuận ở ghép. Mỗi thỏa thuận ở ghép liên kết chính xác theo tỷ lệ một - một với một yêu cầu nhận người ở ghép. Yêu cầu này do chủ nhà tiếp nhận, mang một trạng thái và có thể kèm theo nhiều tệp đính kèm.</w:t></w:r></w:p><w:p w14:paraId="21E2F668" w14:textId="77777777" w:rsidR="00AD1E07" w:rsidRPr="0086622B" w:rsidRDefault="00AD1E07" w:rsidP="00AD1E07"><w:r w:rsidRPr="0086622B"><w:t>Về quy trình đặt phòng và vận hành kỳ ở, một phòng hoặc một chủ nhà có thể tiếp nhận nhiều đơn đặt phòng với các thông tin về giới tính người ở, cách thanh toán và trạng thái đơn. Từ đơn đặt phòng có thể khởi tạo nhiều yêu cầu đổi đơn giữa phòng cũ và phòng mới. Mỗi đơn đặt phòng sẽ khởi tạo đúng một kỳ ở (mối quan hệ một - một) và phát hành đúng một phiếu nhận phòng tương ứng (mối quan hệ một - một). Phiếu nhận phòng do người dùng quét xác nhận và ghi nhận theo từng trạng thái.</w:t></w:r></w:p><w:p w14:paraId="1B13B665" w14:textId="77777777" w:rsidR="00AD1E07" w:rsidRPr="0086622B" w:rsidRDefault="00AD1E07" w:rsidP="00AD1E07"><w:r w:rsidRPr="0086622B"><w:t>Trong thời gian lưu trú, một kỳ ở đăng ký nhiều cư dân (gồm người thuê chính và thành viên ở ghép) cùng nhiều hạng mục bàn giao đi kèm tình trạng thực tế. Ngược lại, một người dùng có thể trở thành cư dân của nhiều kỳ ở khác nhau theo thời gian. Khi kết thúc, mỗi kỳ ở gắn liền trực tiếp với đúng một biên bản trả phòng (mối quan hệ một - một). Biên bản này ghi nhận nhiều khoản khấu trừ và chuyển các dòng vi phạm nội quy thành hóa đơn xử lý.</w:t></w:r></w:p><w:p w14:paraId="5E490686" w14:textId="77777777" w:rsidR="00AD1E07" w:rsidRPr="0086622B" w:rsidRDefault="00AD1E07" w:rsidP="00AD1E07"><w:r w:rsidRPr="0086622B"><w:t xml:space="preserve">Hệ thống xử lý giao dịch, tương tác và kiểm duyệt thông qua việc một đơn đặt phòng có thể thực hiện nhiều lượt thanh toán theo các mục đích và phương thức khác nhau. Lượt thanh </w:t></w:r><w:r w:rsidRPr="0086622B"><w:lastRenderedPageBreak/><w:t>toán hoàn sẽ giải quyết chi phí cho nhiều biên bản trả phòng. Các bài đăng hay tin ở ghép kết nối với nhiều cuộc trò chuyện chứa nhiều tin nhắn. Người dùng có thể lưu yêu thích nhiều bài đăng hay tin ở ghép theo quan hệ nhiều - nhiều, gửi nhiều đánh giá hai chiều sau mỗi kỳ ở, hoặc gửi nhiều báo cáo bài đăng kèm tệp đính kèm để quản trị viên tiến hành kiểm duyệt</w:t></w:r></w:p><w:p w14:paraId="328C279C" w14:textId="77777777" w:rsidR="00AD1E07" w:rsidRPr="0086622B" w:rsidRDefault="00AD1E07" w:rsidP="00AD1E07"/><w:p w14:paraId="45D858D9" w14:textId="77777777" w:rsidR="00AD1E07" w:rsidRPr="00213CAE" w:rsidRDefault="00AD1E07" w:rsidP="00AD1E07"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="1" w:name="_Toc241813417"/><w:r><w:t>3.1 Mô hình quan hệ</w:t></w:r><w:bookmarkEnd w:id="1"/></w:p><w:p w14:paraId="17D55A1F" w14:textId="77777777" w:rsidR="00AD1E07" w:rsidRPr="00213CAE" w:rsidRDefault="00AD1E07" w:rsidP="00AD1E07"><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="24A26AE3" wp14:editId="05EB51EC"><wp:extent cx="5559619" cy="1958340"/><wp:effectExtent l="0" t="0" r="3175" b="3810"/><wp:docPr id="519782061" name="Picture 5"/><wp:cNvGraphicFramePr><a:graphicFrameLocks 